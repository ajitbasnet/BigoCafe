# Supabase – required for auth (login, sign-up, dashboard)
# Get these from https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: redirect URL for email confirmation (defaults to /dashboard)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:8888/dashboard
